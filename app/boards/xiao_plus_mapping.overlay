// This overlay is for when a Xiao Plus board is used standalone, not as part of Flatbox rev7.2.

/ {
    gamepad-buttons {
        compatible = "gpio-keys";
        /* same as start */
        system { gpios = <&xiao_plus_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        start { gpios = <&xiao_plus_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        select { gpios = <&xiao_plus_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        home { gpios = <&xiao_plus_d 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        south { gpios = <&xiao_plus_d 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        east { gpios = <&xiao_plus_d 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        west { gpios = <&xiao_plus_d 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        north { gpios = <&xiao_plus_d 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        dpad-left { gpios = <&xiao_plus_d 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        dpad-right { gpios = <&xiao_plus_d 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        dpad-up { gpios = <&xiao_plus_d 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        dpad-down { gpios = <&xiao_plus_d 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        r1 { gpios = <&xiao_plus_d 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        l1 { gpios = <&xiao_plus_d 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        r2 { gpios = <&xiao_plus_d 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        l2 { gpios = <&xiao_plus_d 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        button14 { gpios = <&xiao_plus_d 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        // skip 16
        r3 { gpios = <&xiao_plus_d 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        l3 { gpios = <&xiao_plus_d 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
    };
};
