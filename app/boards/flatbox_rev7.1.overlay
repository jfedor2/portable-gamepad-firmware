/ {
    gamepad-buttons {
        compatible = "gpio-keys";
        /* same as start */
        system { gpios = <&xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "D0"; };
        start { gpios = <&xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "D0"; };
        select { gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "D1"; };
        home { gpios = <&xiao_d 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "D2"; };
        button14 { gpios = <&expander1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "D3"; };
        l3 { gpios = <&expander1 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA1"; };
        r3 { gpios = <&expander1 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA0"; };
        dpad-left { gpios = <&expander1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA3"; };
        dpad-down { gpios = <&expander1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA2"; };
        dpad-right { gpios = <&expander1 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA6"; };
        dpad-up { gpios = <&expander1 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA4"; };
        west { gpios = <&expander1 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB2"; };
        north { gpios = <&expander1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB6"; };
        r1 { gpios = <&expander1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB5"; };
        l1 { gpios = <&expander1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB4"; };
        south { gpios = <&expander1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPA5"; };
        east { gpios = <&expander1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB3"; };
        r2 { gpios = <&expander1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB1"; };
        l2 { gpios = <&expander1 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; label = "GPB0"; };
    };
};

&xiao_spi {
    cs-gpios = <&xiao_d 5 GPIO_ACTIVE_LOW>;
    expander1: mcp23s17@0 {
        compatible = "microchip,mcp23s17";
        reg = <0>;
        spi-max-frequency = <4000000>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        reset-gpios = <&xiao_d 4 GPIO_ACTIVE_LOW>;
    };
};
